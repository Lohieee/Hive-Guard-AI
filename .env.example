# HIVEGUARD AI - Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# Note: Sensitive secrets are only used server-side (Supabase Edge Functions / Backend).

# Frontend Configuration (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_APP_NAME="HIVEGUARD AI"
VITE_ENABLE_SIMULATION_MODE=true

# Server-Side / Supabase Edge Functions Secrets (NEVER expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
MSG91_AUTH_KEY=your_msg91_authkey_here
MSG91_SENDER_ID=HVGRDAI
MSG91_FLOW_ID=your_msg91_template_flow_id
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Provider Configuration (Razorpay / Indian Payment Gateway)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
